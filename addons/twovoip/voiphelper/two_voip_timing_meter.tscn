offset_top = 2.0
offset_right = 538.0
offset_bottom = 24.0
tooltip_text = "Shared source timeline. The intentional empty span left of the white marker is 300 ms of pre-source time, used to reveal a buffer crossing before the microphone/source moment. Blue is acquisition and yellow bins are packet arrivals. Output cells remain virtually visible after passing the ring read index while their audio crosses the output pipeline. The left edge of the shrinking red bar is physically audible now; the faint pink line is the fixed target, and the small rectangle to the right of red brightens with audible audio. Reference markers turn green and remain fixed while idle."
color = Color(0.12, 0.14, 0.18, 1)

